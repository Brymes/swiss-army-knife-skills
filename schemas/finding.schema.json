{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sak.local/schemas/finding.schema.json",
  "title": "sak findings document",
  "description": "One assessment run's findings with their triage verdicts and evidence records. The verdict vocabulary (confirmed, needs_validation, rejected) follows the Cloudflare security-audit skill, which is MIT licensed; no upstream schema text is copied. Attribution: https://github.com/cloudflare/security-audit-skill.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "findings"],
  "properties": {
    "schema_version": { "const": "1" },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "target": { "type": "string" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "dedupe": {
      "type": "array",
      "description": "Cumulative log of records collapsed by fingerprint. Kept records remain in findings.",
      "items": { "$ref": "#/$defs/dedupe_group" }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["confirmed", "needs_validation", "rejected"]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "severity",
        "asset",
        "entrypoint",
        "root_cause",
        "principal",
        "resource",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^F-[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "severity": { "$ref": "#/$defs/severity" },
        "asset": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "root_cause": { "type": "string", "minLength": 1 },
        "principal": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "description": { "type": "string" },
        "impact": { "type": "string" },
        "remediation": { "type": "string" },
        "cwe": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "reason": { "type": "string" },
        "open_question": { "type": "string" },
        "next_action": { "type": "string" },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "status_history": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "confirmed" } },
            "required": ["status"]
          },
          "then": {
            "required": ["evidence"],
            "properties": { "evidence": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "needs_validation" } },
            "required": ["status"]
          },
          "then": { "required": ["open_question", "next_action"] }
        },
        {
          "if": {
            "properties": { "status": { "const": "rejected" } },
            "required": ["status"]
          },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string" },
        "prompt": { "type": "string" },
        "adapter": { "type": "string" },
        "engine": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "timestamp", "producer"],
      "properties": {
        "id": { "type": "string", "pattern": "^E-[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "kind": {
          "type": "string",
          "enum": [
            "request",
            "response",
            "command",
            "log",
            "source",
            "observed",
            "screenshot",
            "other"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "timestamp": { "type": "string", "format": "date-time" },
        "producer": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "at", "actor"],
      "properties": {
        "from": { "$ref": "#/$defs/status" },
        "to": { "$ref": "#/$defs/status" },
        "at": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      }
    },
    "dedupe_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "kept", "removed"],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "kept": { "type": "string" },
        "removed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "status"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "status": { "$ref": "#/$defs/status" }
            }
          }
        },
        "reason": { "type": "string" }
      }
    }
  }
}
